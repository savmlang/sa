// SASM Core
Root =
  Item*

Item =
  ImportDef | ConstDef | ExternDef | FnDef | StructDef

IdentData =
  Identifier | RawIdentifier

Identifier =
  'Ident'

RawIdentifier =
  'RawIdent'

CommentDoc =
  'DocComment'

// Paths
Path =
  AbsolutePath PathWildcard?

PathWildcard =
  '.' '*'

AbsolutePath =
  iter_segment:IdentData merge_segment:PathPartial*

PathPartial =
  '.' segment:IdentData

// Types
ExtendedTypeRef =
  TypeRef | InferDefault

TypeRef =
  PtrPrefix? AbsolutePath generics:GenericData? constants:ConstantData?

PtrPrefix =
  '*' 'mut'?

GenericData =
  '<' iter_generic:ExtendedTypeRef merge_generic:GenericDataExtended* '>'

GenericDataExtended =
  ',' generic:ExtendedTypeRef

Constant =
  InferDefault | BoolLiteral | NumLiteral | FpLiteral

InferDefault =
  '^'

ConstantData =
  '(' iter_constant:Constant merge_constant:ConstantDataExtended* ')'

ConstantDataExtended =
  ',' constant:Constant

// Directives
// @stackLimit(30)
// @runtime(1.41)
DirectiveDecl =
  'Directive' args:DirectiveArgs?

//# `merge_args` is our custom macro that merges the args from DirectiveExtendedArgs
DirectiveArgs =
  '(' DirectiveArgsList? ')'

DirectiveArgsList =
  iter_args:LiteralExpr merge_args:DirectiveExtendedArgs*

DirectiveExtendedArgs =
  ',' args:LiteralExpr

// Decl
ImportDef =
  'import' Path ';'

UnitTypeRef =
  ':' returns:TypeRef

AbiDataRef =
  '(' iter_abi:IdentData merge_abi:AbiDataExtendedRef* ')'

AbiDataExtendedRef =
  ',' abi:IdentData

// StructDef
StructDef =
  comments:CommentDoc*
  'export'?
  abi:AbiDataRef?
  'struct'
  name:IdentData
  generics:GenericDef?
  ConstantDef?
  StructDecl

StructDecl =
  StructMarker | StructFields

StructMarker =
  ';'

// Struct Fields
StructFields =
  '{' StructFieldData? '}'

StructFieldData =
  iter_fields:StructField merge_fields:StructFieldExtended* ','?

StructFieldExtended =
  ',' fields:StructField

StructField =
  name:IdentData ':' typedata:TypeRef

// GenericDef
GenericDef =
  '<' iter_generics:GenericDecl merge_generics:GenericDeclExtended* '>'

GenericDeclExtended =
  ',' generics:GenericDecl

GenericDecl =
  name:IdentData ':' property:TypeRef GenericDeclDefault?

GenericDeclDefault =
  '=' typedata:TypeRef

// ConstantDef
ConstantDef =
  '(' iter_generics:ConstantDecl merge_generics:ConstantDeclExtended* ')'

ConstantDeclExtended =
  ',' generics:ConstantDecl

ConstantDeclData =
  BoolLiteral | NumLiteral | FpLiteral

ConstantDecl =
  name:IdentData ':' typedata:TypeRef ConstantDeclDefault?

ConstantDeclDefault =
  '=' value:ConstantDeclData

// ConstDef
ConstDef =
  comments:CommentDoc*
  'export'?
  'const'
  name:IdentData
  returns:UnitTypeRef?
  '='
  value:LiteralExpr
  ';'

// extern printf(fmt: *u8): i32;
ExternDef =
  comments:CommentDoc*
  'extern'
  AbiDataRef?
  name:IdentData
  parameters:ParamList
  returns:UnitTypeRef?
  ';'

// fn main(argc: i32): i32 { ... }
// export(In) fn raw_writer() aware { ... }
// export aware fn raw_writer() aware { ... }
FnDef =
  comments:CommentDoc*
  directives:DirectiveDecl*
  'export'?
  abi:AbiDataRef?
  'aware'?
  'fn'
  name:IdentData
  parameters:ParamList
  returns:UnitTypeRef?
  body:BlockExpr

ParamList =
  '(' parameters:Params? ')'

Params =
  iter_parameter:Param merge_parameter:ParamPart*

ParamPart =
  ',' parameter:Param

Param =
  name:IdentData typedata:UnitTypeRef?

// Blocks
Stmt =
  LetStmt | ExprStmt | ReturnStmt

ReturnStmt =
  'return' out:Expr? ';'

LetStmt =
  'let' 'mut'? name:IdentData returns:UnitTypeRef? value:LetAssignment? ';'

LetAssignment =
  '=' value:Expr

ExprStmt =
  Expr ';'

Expr =
  LiteralExpr | AbsolutePath | CallExpr | BlockExpr | BinaryExpr | PrefixExpr

// PrefixExpr
PrefixExpr =
  prefix:PrefixOp val:Expr

PrefixOp =
  InvertOp | NegOp | BorrowOp | BorrowMutOp | PtrOp

InvertOp =
  '~'

NegOp =
  '-'

BorrowOp =
  '&'

BorrowMutOp =
  '&' 'mut'

PtrOp =
  '&' 'ptr'

// Binary Expr
BinaryExpr =
  lhs:Expr op:BinaryOp rhs:Expr

BinaryOp =
  PlusOp
| MinusOp
| MulOp
| DivOp
| EqOp
| NeOp
| LtOp
| GtOp
| LeOp
| GeOp
| BitAnd
| BitOr
| BitXor
| BitShl
| BitShr

BitAnd =
  '&'

BitOr =
  '|'

BitXor =
  '^'

BitShl =
  '<' '<'

BitShr =
  '>' '>'

PlusOp =
  '+'

MinusOp =
  '-'

MulOp =
  '*'

DivOp =
  '/'

EqOp =
  '=' '='

NeOp =
  '!' '='

LtOp =
  '<'

GtOp =
  '>'

LeOp =
  '<' '='

GeOp =
  '>' '='

// Block Expr
BlockExpr =
  'aware'? '{' statements:Stmt* tail:Expr? '}'

// Literal Expr
LiteralExpr =
  BoolLiteral | StrLiteral | NumLiteral | FpLiteral

BoolLiteral =
  'BoolLit'

StrLiteral =
  'StrLit'

NumLiteral =
  'NumLit'

FpLiteral =
  'FpLit'

// CallExpr
CallExpr =
  callee:AbsolutePath '(' Args? ')'

Args =
  iter_expr:Expr merge_expr:ArgsExtended*

ArgsExtended =
  ',' expr:Expr