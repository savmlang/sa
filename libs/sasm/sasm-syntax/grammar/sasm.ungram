// SASM Core
Root =
  Item*

Item =
  ImportDef | ConstDef | ExternDef | FnDef

IdentData =
  Identifier | RawIdentifier

Identifier =
  'Ident'

RawIdentifier =
  'RawIdent'

CommentDoc =
  'DocComment'

// Paths
Path =
  AbsolutePath PathWildcard?

PathWildcard =
  '.' '*'

AbsolutePath =
  iter_segment:IdentData merge_segment:PathPartial*

PathPartial =
  '.' segment:IdentData

// Types
TypeRef =
  '*'? AbsolutePath

// Directives
// @stackLimit(30)
// @runtime(1.41)
DirectiveDecl =
  'Directive' args:DirectiveArgs?

//# `merge_args` is our custom macro that merges the args from DirectiveExtendedArgs
DirectiveArgs =
  '(' DirectiveArgsList? ')'

DirectiveArgsList =
  iter_args:LiteralExpr merge_args:DirectiveExtendedArgs*

DirectiveExtendedArgs =
  ',' args:LiteralExpr

// Decl
ImportDef =
  'import' Path ';'

UnitTypeRef =
  ':' returns:TypeRef

AbiDataRef =
  '(' abiinfo:AbiDataInfo ')'

AbiDataInfo =
  iter_abi:IdentData merge_abi:AbiDataExtendedRef*

AbiDataExtendedRef =
  ',' abi:IdentData

ConstDef =
  comments:CommentDoc*
  'export'?
  'const'
  name:IdentData
  returns:UnitTypeRef?
  '='
  value:LiteralExpr
  ';'

// extern printf(fmt: *u8): i32;
ExternDef =
  comments:CommentDoc*
  'extern'
  AbiDataRef?
  name:IdentData
  parameters:ParamList
  returns:UnitTypeRef?
  ';'

// fn main(argc: i32): i32 { ... }
// export(In) fn raw_writer() aware { ... }
// export aware fn raw_writer() aware { ... }
FnDef =
  comments:CommentDoc*
  directives:DirectiveDecl*
  'export'?
  abi:AbiDataRef?
  'aware'?
  'fn'
  name:IdentData
  parameters:ParamList
  returns:UnitTypeRef?
  body:BlockExpr

ParamList =
  '(' parameters:Params? ')'

Params =
  iter_parameter:Param merge_parameter:ParamPart*

ParamPart =
  ',' parameter:Param

Param =
  name:IdentData returns:UnitTypeRef?

// Blocks
Stmt =
  LetStmt | ExprStmt | ReturnStmt

ReturnStmt =
  'return' out:Expr? ';'

LetStmt =
  'let' 'mut'? name:IdentData returns:UnitTypeRef? value:LetAssignment? ';'

LetAssignment =
  '=' value:Expr

ExprStmt =
  Expr ';'

Expr =
  LiteralExpr | AbsolutePath | CallExpr | BlockExpr

BlockExpr =
  'aware'? '{' statements:Stmt* tail:Expr? '}'

LiteralExpr =
  BoolLiteral | StrLiteral | NumLiteral | FpLiteral

BoolLiteral =
  'BoolLit'

StrLiteral =
  'StrLit'

NumLiteral =
  'NumLit'

FpLiteral =
  'FpLit'

CallExpr =
  callee:AbsolutePath ArgList

ArgList =
  '(' Args? ')'

Args =
  iter_expr:Expr merge_expr:ArgsExtended*

ArgsExtended =
  ',' expr:Expr