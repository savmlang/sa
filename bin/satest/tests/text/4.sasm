; Factorial of 20 = 2432902008176640000

#import *

#define MARK_LOOP_BEGIN 1::u64

; This is output
reg $r1::u8, 0::u8, 1::u64

; Our countdown system!
reg $r2::u8, 0::u8, 20::u64

; Lets pre-define it
reg $r3::u8, 0::u8, 1::u64

; Set r4 to `0`
reg $r4::u8, 0::u8, 0::u64

mark $MARK_LOOP_BEGIN::u64
  ; r1 = r1*r2
  vmul %u32[ $u64::u4 | $r1::u4 | $r2::u4 | $r1::u4 | 0::u16 ], 1::u32, 0::u32, 0::u32, 0::u32

  ; r2 = r2 - 1
  vsub %u32[ $u64::u4 | $r2::u4 | $r3::u4 | $r2::u4 | 0::u16 ], 1::u32, 0::u32, 0::u32, 0::u32

  ; if $r2 == 0
  vcmp %u8[ $w64::u3 | $IOP_EQ::u5 ], %u16[ $r2::u4 | $r4::u4 | $r4::u4 | 0::u4 ], 1::u32, 0::u32, 0::u32, 0::u32
  ; jmp if $r2 == 0
  jif %u8[ 1::u1 | 0::u2 | 0::u1 | $r4::u4 ], 0::u32, 2::u64

  jmp $MARK_LOOP_BEGIN::u64

mark 2::u64