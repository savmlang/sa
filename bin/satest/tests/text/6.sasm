#import *

; TEST u64 ADD
reg $r1::u8, fp100.0::u64
reg $r2::u8, fp200.0::u64

vaddf %u32[ 0::u3 | $FOP_f64::u1 | $r1::u4 | $r2::u4 | $r3::u4 ], 1::u32, 0::u32, 0::u32, 0::u32

; TEST u32,u16,2xu8 ADD
reg $r4::u8, %u64[ fp200.0::u32 | fp30.0::u32 ]
reg $r5::u8, %u64[ fp800.0::u32 | fp900.0::u32 ]

; u32 ADD (+ offset 0, + count = 2)
vaddf %u32[ 0::u3 | $FOP_f32::u1 | $r4::u4 | $r5::u4 | $r6::u4 ], 2::u32, 0::u32, 0::u32, 0::u32
