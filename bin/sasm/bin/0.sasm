; We shall write a program to find the 3rd prime number

#import *
#define MARK_LOOP_BEGIN 1::u64
#define MARK_REM_0 2::u64
#define LOOP_NEXT 3::u64
#define LOOP_BREAK 4::u64

#macro #increment @flags
  #assert @flags 32
  #import *

  reg $r8::u8, 0::u8, 0::u64

  vadd @flags, 1::u32, 0::u32, 0::u32, 0::u32
#end

#macro #eq @flags
  #assert @flags 16
  #import *

  vcmp %u8[ $COUNT_ABSOLUTE::u1 | $w64::u2 | $IOP_EQ::u5 ], @flags, 1::u32, 0::u32, 0::u32, 0::u32
#end

; r1 = current number to test
reg $r1::u8, 0::u8, 2::u64

; r7 = stores how many prime have been found!
reg $r7::u8, 0::u8, 0::u64

; r2 = loop helper
reg $r2::u8, 0::u8, 2::u64

mark $MARK_LOOP_BEGIN::u64
  ; Remainder
  ; type is u64, get dividend from r1, divisor from r2, store remainder in r3
  rem %u16[ $u64::u4 | $r1::u4 | $r2::u4 | $r3::u4 ], 0::u32, 0::u32, 0::u32

  ; If r1 == r2
  ; We found a prime, increment & loop again
  #eq %u16[ $r1::u4 | $r2::u4 | $r3::u4 | 0::u4 ]
  jif %u8[ $OP_JNZ::u1 | $w64::u2 | 0::u1 | $r3::u4 ], 0::u32, $LOOP_NEXT::u64

  ; If Remainder == 0
  ; We found a composite number, loop again
  reg $r8::u8, 0::u8, 0::u64
  #eq %u16[ $r8::u4 | $r3::u4 | $r3::u4 | 0::u4 ]
  
  reg $r8::u8, 0::u8, 1::u64
  jif %u8[ $OP_JNZ::u1 | $w64::u2 | 0::u1 | $r3::u4 ], 0::u32, $MARK_REM_0::u64

  ; Remainder != 0
  ; Increment r2 and jmp again
  ; We rely on earlier reg r8=1
  #increment %u32[ $u64::u3 | $COUNT_ABSOLUTE::u1 | $r2::u4 | $r8::u4 | $r2::u4 | 0::u1 | 0::u1 | 0::u1 | 0::u13 ]

  jmp $MARK_LOOP_BEGIN::u64

; Loop Next
mark $LOOP_NEXT::u64
  ; Increment counter in r7
  reg $r8::u8, 0::u8, 1::u64

  ; Call our macro
  #increment %u32[ $u64::u3 | $COUNT_ABSOLUTE::u1 | $r7::u4 | $r8::u4 | $r7::u4 | 0::u1 | 0::u1 | 0::u1 | 0::u13 ]

  ; Check if r7==3
  reg $r6::u8, 0::u8, 3::u64
  #eq %u16[ $r7::u4 | $r6::u4 | $r6::u4 | 0::u4 ]
  jif %u8[ $OP_JNZ::u1 | $w64::u2 | 0::u1 | $r6::u4 ], 0::u32, $LOOP_BREAK::u64

; If remainder turned out to `0`
; Move to next number
mark $MARK_REM_0::u64

  ; Call our macro
  #increment %u32[ $u64::u3 | $COUNT_ABSOLUTE::u1 | $r1::u4 | $r8::u4 | $r1::u4 | 0::u1 | 0::u1 | 0::u1 | 0::u13 ]

  reg $r2::u8, 0::u8, 2::u64

  jmp $MARK_LOOP_BEGIN::u64

mark $LOOP_BREAK::u64