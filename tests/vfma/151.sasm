#import *

; Catastrophic cancellation avoidance with large magnitude terms: (x + 1)(x - 1) - x^2 = -1.0
; Case 1: x = 2^27 = 134217728.0
; x + 1 = 134217729.0 (0x41a0000002000000)
reg $r1::u8, 0::u8, 0x41a0000002000000::u64
; x - 1 = 134217727.0 (0x419ffffffc000000)
reg $r2::u8, 0::u8, 0x419ffffffc000000::u64
; -x^2 = -2^54 (0xc350000000000000)
reg $r3::u8, 0::u8, 0xc350000000000000::u64

; Case 2: y = 2^28 = 268435456.0
; y + 1 = 268435457.0 (0x41b0000001000000)
reg $r4::u8, 0::u8, 0x41b0000001000000::u64
; y - 1 = 268435455.0 (0x41affffffe000000)
reg $r5::u8, 0::u8, 0x41affffffe000000::u64
; -y^2 = -2^56 (0xc370000000000000)
reg $r8::u8, 0::u8, 0xc370000000000000::u64

; Copy r1..r5 to scratchpad (40 bytes)
vcopy %u8[ 0::u1 | 0::u7 ], %u8[ $r1::u4 | $scratchpad::u4 ], 40::u32, 0::u32, 0::u32
; Copy r8 to scratchpad at offset 40 (8 bytes)
vcopy %u8[ 0::u1 | 0::u7 ], %u8[ $r8::u4 | $scratchpad::u4 ], 8::u32, 0::u32, 40::u32

; FMA Case 1: (2^27 + 1) * (2^27 - 1) - 2^54 = -1.0
; Double rounding gives 0.0, FMA gives -1.0 (0xbff0000000000000)
vfma %u16[ $scratchpad::u4 | $scratchpad::u4 | $scratchpad::u4 | $scratchpad::u4 ], 0::u8, 1::u32, 0::u32, 1::u32, 2::u32, 6::u32

; FMA Case 2: (2^28 + 1) * (2^28 - 1) - 2^56 = -1.0
; Double rounding gives 0.0, FMA gives -1.0 (0xbff0000000000000)
vfma %u16[ $scratchpad::u4 | $scratchpad::u4 | $scratchpad::u4 | $scratchpad::u4 ], 0::u8, 1::u32, 3::u32, 4::u32, 5::u32, 7::u32

; Copy scratchpad[6..8] to r6, r7
vcopy %u8[ 0::u1 | 0::u7 ], %u8[ $scratchpad::u4 | $r6::u4 ], 16::u32, 48::u32, 0::u32
