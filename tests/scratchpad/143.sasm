#import *

reg $r1::u8, 0::u8, 4660::u64
reg $r2::u8, 0::u8, 22136::u64

; write r1 to scratchpad at offset 16
vcopy %u8[ 0::u1 | 0::u7 ], %u8[ $r1::u4 | $scratchpad::u4 ], 8::u32, 0::u32, 16::u32

; write r2 to scratchpad at offset 24
vcopy %u8[ 0::u1 | 0::u7 ], %u8[ $r2::u4 | $scratchpad::u4 ], 8::u32, 0::u32, 24::u32

; read 16 bytes from scratchpad offset 16 to r3, r4
vcopy %u8[ 0::u1 | 0::u7 ], %u8[ $scratchpad::u4 | $r3::u4 ], 16::u32, 16::u32, 0::u32

; read 8 bytes from scratchpad offset 24 to r5
vcopy %u8[ 0::u1 | 0::u7 ], %u8[ $scratchpad::u4 | $r5::u4 ], 8::u32, 24::u32, 0::u32
