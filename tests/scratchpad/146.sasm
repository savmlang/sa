#import *

reg $r1::u8, 0::u8, 100::u64
reg $r2::u8, 0::u8, 200::u64
reg $r3::u8, 0::u8, 10::u64
reg $r4::u8, 0::u8, 20::u64

; copy 16 bytes (r1, r2) to scratchpad at offset 0
vcopy %u8[ 0::u1 | 0::u7 ], %u8[ $r1::u4 | $scratchpad::u4 ], 16::u32, 0::u32, 0::u32

; vector vadd count=2: scratchpad[0..2] + [r3, r4] -> scratchpad[2..4] (elem 2 = byte offset 16)
vadd %u32[ $u64::u4 | $scratchpad::u4 | $r3::u4 | $scratchpad::u4 | 0::u16 ], 2::u32, 0::u32, 0::u32, 2::u32

; copy 16 bytes from scratchpad byte offset 16 to r5, r6
vcopy %u8[ 0::u1 | 0::u7 ], %u8[ $scratchpad::u4 | $r5::u4 ], 16::u32, 16::u32, 0::u32
