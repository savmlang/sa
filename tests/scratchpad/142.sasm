#import *

reg $r1::u8, 0::u8, 24::u64

reg $r2::u8, 0::u8, 111::u64
reg $r3::u8, 0::u8, 222::u64
reg $r4::u8, 0::u8, 333::u64

; vcopy 24 bytes from r2, r3, r4 to scratchpad using runtime count in r1
vcopy %u8[ 1::u1 | 0::u7 ], %u8[ $r2::u4 | $scratchpad::u4 ], 0::u32, 0::u32, 0::u32

; vcopy 24 bytes from scratchpad to r5, r6, r7 using runtime count in r1
vcopy %u8[ 1::u1 | 0::u7 ], %u8[ $scratchpad::u4 | $r5::u4 ], 0::u32, 0::u32, 0::u32
