#import *

reg $r1::u8, 0::u8, 500::u64
reg $r2::u8, 0::u8, 700::u64

; vadd r1 + r2 -> scratchpad
vadd %u32[ $u64::u4 | $r1::u4 | $r2::u4 | $scratchpad::u4 | 0::u16 ], 1::u32, 0::u32, 0::u32, 0::u32

; copy from scratchpad to r3
vcopy %u8[ 0::u1 | 0::u7 ], %u8[ $scratchpad::u4 | $r3::u4 ], 8::u32, 0::u32, 0::u32
