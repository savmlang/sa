#import *

reg $r1::u8, 0::u8, 100::u64
reg $r2::u8, 0::u8, 200::u64

; vcopy 16 bytes from r1, r2 to scratchpad
vcopy %u8[ 0::u1 | 0::u7 ], %u8[ $r1::u4 | $scratchpad::u4 ], 16::u32, 0::u32, 0::u32

; vcopy 16 bytes from scratchpad to r3, r4
vcopy %u8[ 0::u1 | 0::u7 ], %u8[ $scratchpad::u4 | $r3::u4 ], 16::u32, 0::u32, 0::u32
