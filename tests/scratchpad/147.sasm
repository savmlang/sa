#import *

reg $r1::u8, 0::u8, 10::u64
reg $r2::u8, 0::u8, 20::u64
reg $r3::u8, 0::u8, 30::u64
reg $r4::u8, 0::u8, 40::u64

; copy 32 bytes (r1..r4) to scratchpad
vcopy %u8[ 0::u1 | 0::u7 ], %u8[ $r1::u4 | $scratchpad::u4 ], 32::u32, 0::u32, 0::u32

; copy 32 bytes from scratchpad to r5..r8
vcopy %u8[ 0::u1 | 0::u7 ], %u8[ $scratchpad::u4 | $r5::u4 ], 32::u32, 0::u32, 0::u32
