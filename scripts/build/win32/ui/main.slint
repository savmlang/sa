import { Palette } from "std-widgets.slint";
import { HomePage } from "home.slint";
import { LicensePage } from "license.slint";
import { InstallingPage } from "install.slint";
import { UninstallingPage } from "uninstall.slint";
import { Configure } from "config.slint";

enum Page { launchpad, license, configure, repairconf, repair, installing, uninstall }


export component MainWindow inherits Window {
    in-out property <bool> dark: Palette.color-scheme == ColorScheme.dark;

    in-out property <bool> win10: true;
    in-out property <brush> backg: Palette.background;

    background <=> backg;
    default-font-family: "Segoe UI Variable, Segoe UI";

    min-height: 600px;
    min-width: 800px;

    preferred-height: 600px;
    preferred-width: 800px;

    max-height: 600px;
    max-width: 800px;

    no-frame: false;

    title: "SaVM Installer";
    icon: @image-url("../assets/salang.png");

    // Properties
    in-out property <Page> curpage: Page.launchpad;

    in-out property <bool> installed: false;
    in-out property <bool> uninstalled: false;
    in-out property <float> prog: 0.0;
    in-out property <string> status: "Preparing";

    in-out property <[bool]> configs: [false, false, false, true, true, true, true];

    in-out property <[string]> licensegpl: [
        "Water is given for all mortals",
        "A vessel, as seen of flowing trust",
        "to the mortals, flowing forever",
        "Who get a chance to behold, the earth",
        "of good days, happiness and months of sleep",
        "Or so i hold, a view from above. What I think",
        "would be the gloomy days, may simple sheep",
        "sleep well in the rainy days, the dearth of",
        "sunken ways, winter comes, so as I see",
        "they cannot think of a chance to break free.",
        "The water in the darkened ways, thinks of thee",
        "O! Can they break free. I think of that, so ",
        "as the flow of thee, that how can they break free",
        "As the winter drifts, and the cloud sits",
        "the flow see, a few broke free, in the darkened",
        "ways, thinks of thee, they went thee or thee?",
        "Water sees none, nor in the course, as it flow",
        "from its source, where they went thee? they broke",
        "free? hwænne they? where thou went in the spree?",
        "did they really broke free? or free? A few did"
    ];
    callback startinstall(bool);

    if (win10 && dark): Rectangle {
        background: @radial-gradient(circle, rgba(43, 27, 54, 85%) 0%, rgba(32, 23, 40, 40%) 50%, transparent 100%);
    }

    if (win10 && dark): Rectangle {
        background: @radial-gradient(circle, rgba(37, 24, 33, 40%) 0%, transparent 70%);
    }

    if (curpage == Page.launchpad): HomePage {
        is-active: curpage == Page.launchpad;

        next => {
            curpage = Page.license;
        }
    }

    // PAGE 2: License Page
    if (curpage == Page.license): LicensePage {
        is-active: curpage == Page.license;
        licensegpl: licensegpl;

        next => {
            curpage = Page.configure;
        }
    }

    if (curpage == Page.configure || curpage == Page.repairconf): Configure {
        configs <=> configs;

        is-active: curpage == Page.configure || curpage == Page.repairconf;
        repair: curpage == Page.repairconf;

        next => {
            let is_repair = curpage == Page.repairconf;
            curpage = is_repair ? Page.repair : Page.installing;
            startinstall(is_repair);
        }
    }

    if (curpage == Page.installing || curpage == Page.repair): InstallingPage {
        is-active: curpage == Page.installing || curpage == Page.repair;
        prog: prog;
        status: status;
        installed: installed;
        repair: curpage == Page.repair;

        next => {
            curpage = Page.installing;
        }
    }

    if (curpage == Page.uninstall): UninstallingPage {
        is-active: curpage == Page.uninstall;
        uninstalled: uninstalled;
    }
}
