; Benchmark 3: Horner's Method Polynomial Evaluator (Floating-Point FMA Chain)
; Footprint: 40 bytes (5 x 64-bit float coefficients loaded across r1–r5, x in r6)
; What it stresses:
;   - Fused Multiply-Add instruction pipeline throughput (vfma)
;   - Register dependency chains without branching
;   - Pure in-register floating-point computation
; Algorithm:
;   P(x) = c0 + x * (c1 + x * (c2 + x * (c3 + x * c4)))
; Repeatedly evaluate a 4th-degree polynomial over an input range strictly using in-register operations.

#import *

#define MARK_LOOP_BEGIN 1::u64

; 5 x 64-bit float coefficients (40 bytes footprint)
; c0 = 1.0, c1 = 2.0, c2 = 3.0, c3 = 4.0, c4 = 5.0
reg $r1::u8, 0::u8, fp1.0::u64
reg $r2::u8, 0::u8, fp2.0::u64
reg $r3::u8, 0::u8, fp3.0::u64
reg $r4::u8, 0::u8, fp4.0::u64
reg $r5::u8, 0::u8, fp5.0::u64

; Input x = 0.5
reg $r6::u8, 0::u8, fp0.5::u64

; Loop counter in r8 (1000 iterations)
reg $r8::u8, 0::u8, 1000::u64

mark $MARK_LOOP_BEGIN::u64
  ; Step 1: r7 = x * c4 + c3
  vfma %u16[ $r6::u4 | $r5::u4 | $r4::u4 | $r7::u4 ], 0::u8, 1::u32, 0::u32, 0::u32, 0::u32, 0::u32

  ; Step 2: r7 = x * r7 + c2
  vfma %u16[ $r6::u4 | $r7::u4 | $r3::u4 | $r7::u4 ], 0::u8, 1::u32, 0::u32, 0::u32, 0::u32, 0::u32

  ; Step 3: r7 = x * r7 + c1
  vfma %u16[ $r6::u4 | $r7::u4 | $r2::u4 | $r7::u4 ], 0::u8, 1::u32, 0::u32, 0::u32, 0::u32, 0::u32

  ; Step 4: r7 = x * r7 + c0 -> P(x)
  vfma %u16[ $r6::u4 | $r7::u4 | $r1::u4 | $r7::u4 ], 0::u8, 1::u32, 0::u32, 0::u32, 0::u32, 0::u32

  ; Decrement loop counter: r8 = r8 - 1
  reg $scratchpad::u8, 0::u8, 1::u64
  vsub %u32[ $u64::u4 | $r8::u4 | $scratchpad::u4 | $r8::u4 | 0::u16 ], 1::u32, 0::u32, 0::u32, 0::u32
  jif %u8[ $OP_JNZ::u1 | $w64::u2 | 0::u1 | $r8::u4 ], 0::u32, $MARK_LOOP_BEGIN::u64
