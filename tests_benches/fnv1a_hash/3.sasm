; Benchmark 4: 64-bit FNV-1a Hash Kernel (Bitwise & Rotate Stressor)
; Footprint: 16 bytes (State/Hash in r1, prime/xor constants in r2, loop counter in r3)
; What it stresses:
;   - Bitwise XOR (vbit with VBIT_XOR)
;   - 64-bit integer multiplication (vmul)
;   - Bit rotations (vrot with rotl)
;   - Register unrolling in LLVM/Cranelift
; Algorithm:
;   hash <- (hash ^ byte) * FNV_prime
;   hash <- rotl(hash, rot_amt)

#import *

#define MARK_LOOP_BEGIN 1::u64

; r1: Initial FNV-1a 64-bit offset basis (0xcbf29ce484222325)
reg $r1::u8, 0::u8, 0xcbf29ce484222325::u64

; r2: FNV-1a 64-bit prime (0x100000001b3 = 1099511628211)
reg $r2::u8, 0::u8, 0x100000001b3::u64

; r3: Loop counter (1000 iterations)
reg $r3::u8, 0::u8, 1000::u64

; r4: Rotation amount (27 bits)
reg $r4::u8, 0::u8, 27::u64

; r5: Data / byte sequence (starts at 0x5a)
reg $r5::u8, 0::u8, 0x5a::u64

; r6: Constant 1 for increment/decrement
reg $r6::u8, 0::u8, 1::u64

mark $MARK_LOOP_BEGIN::u64
  ; Step 1: hash = hash ^ byte (r1 = r1 ^ r5)
  vbit %u16[ 0::u2 | 0::u2 | $r1::u4 | $r5::u4 | $r1::u4 ], %u8[ $VBIT_XOR::u4 | 0::u4 ], 1::u32, 0::u32, 0::u32, 0::u32

  ; Step 2: hash = hash * FNV_prime (r1 = r1 * r2)
  vmul %u32[ $u64::u4 | $r1::u4 | $r2::u4 | $r1::u4 | 0::u16 ], 1::u32, 0::u32, 0::u32, 0::u32

  ; Step 3: hash = rotl(hash, 27) (r1 rotated left by r4=27)
  vrot %u16[ $u64::u4 | $r1::u4 | $r4::u4 | $r1::u4 ], %u8[ 0::u7 | 0::u1 ], 1::u32, 0::u32, 0::u32, 0::u32

  ; Step 4: Advance byte/data: r5 = r5 + 1
  vadd %u32[ $u64::u4 | $r5::u4 | $r6::u4 | $r5::u4 | 0::u16 ], 1::u32, 0::u32, 0::u32, 0::u32

  ; Step 5: Decrement loop counter: r3 = r3 - 1
  vsub %u32[ $u64::u4 | $r3::u4 | $r6::u4 | $r3::u4 | 0::u16 ], 1::u32, 0::u32, 0::u32, 0::u32
  jif %u8[ $OP_JNZ::u1 | $w64::u2 | 0::u1 | $r3::u4 ], 0::u32, $MARK_LOOP_BEGIN::u64
