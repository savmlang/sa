#import *
; -------------------------------------------------------------
; Benchmark 5: 64-Bit Integer Avalanche Hash (10,000 internal loops)
; -------------------------------------------------------------
reg $r8::u8, 0::u8, 10000::u64

mark 5::u64
reg $r1::u8, 0::u8, 0x18F4279C51D3E02A::u64
reg $r2::u8, 0::u8, 0x853C49E6748FEA9B::u64
reg $r4::u8, 0::u8, 0x9E3779B97F4A7C15::u64
reg $r5::u8, 0::u8, 0xBF58476D1CE4E5B9::u64

; r3 = r1 + r2
vadd %u32[ $u64::u4 | $r1::u4 | $r2::u4 | $r3::u4 | 0::u16 ], 1::u32, 0::u32, 0::u32, 0::u32
vbit %u16[ 0::u2 | $r3::u2 | 0::u4 | $r4::u4 | $r3::u4 ], %u8[ $VBIT_XOR::u4 | 0::u4 ], 1::u32, 0::u32, 0::u32, 0::u32
vmul %u32[ $u64::u4 | $r3::u4 | $r5::u4 | $r6::u4 | 0::u16 ], 1::u32, 0::u32, 0::u32, 0::u32
vadd %u32[ $u64::u4 | $r6::u4 | $r1::u4 | $r7::u4 | 0::u16 ], 1::u32, 0::u32, 0::u32, 0::u32
vbit %u16[ 0::u2 | $r3::u2 | 0::u4 | $r2::u4 | $r7::u4 ], %u8[ $VBIT_XOR::u4 | 0::u4 ], 1::u32, 0::u32, 0::u32, 0::u32

; Decrement loop counter in r8
reg $r7::u8, 0::u8, 1::u64
vsub %u32[ $u64::u4 | $r8::u4 | $r7::u4 | $r8::u4 | 0::u16 ], 1::u32, 0::u32, 0::u32, 0::u32
jif %u8[ $OP_JNZ::u1 | $w64::u2 | 0::u1 | $r8::u4 ], 0::u32, 5::u64
