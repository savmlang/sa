#import *
; -------------------------------------------------------------
; Benchmark 3: Horner Degree-7 Polynomial (10,000 internal loops)
; -------------------------------------------------------------
reg $r8::u8, 0::u8, 10000::u64

mark 3::u64
reg $r1::u8, 0::u8, fp1.75::u64
reg $r2::u8, 0::u8, fp2.0::u64
reg $r3::u8, 0::u8, fp0.625::u64
reg $r4::u8, 0::u8, fp-1.125::u64
reg $r5::u8, 0::u8, fp4.5::u64
reg $r6::u8, 0::u8, fp-0.875::u64
reg $r7::u8, 0::u8, fp3.125::u64

; acc = r1 * r2 + r3
vfma %u16[ $r1::u4 | $r2::u4 | $r3::u4 | $r2::u4 ], 0::u8, 1::u32, 0::u32, 0::u32, 0::u32, 0::u32
vfma %u16[ $r1::u4 | $r2::u4 | $r4::u4 | $r2::u4 ], 0::u8, 1::u32, 0::u32, 0::u32, 0::u32, 0::u32
vfma %u16[ $r1::u4 | $r2::u4 | $r5::u4 | $r2::u4 ], 0::u8, 1::u32, 0::u32, 0::u32, 0::u32, 0::u32
vfma %u16[ $r1::u4 | $r2::u4 | $r6::u4 | $r2::u4 ], 0::u8, 1::u32, 0::u32, 0::u32, 0::u32, 0::u32
vfma %u16[ $r1::u4 | $r2::u4 | $r7::u4 | $r2::u4 ], 0::u8, 1::u32, 0::u32, 0::u32, 0::u32, 0::u32
reg $r7::u8, 0::u8, fp-2.25::u64
vfma %u16[ $r1::u4 | $r2::u4 | $r7::u4 | $r2::u4 ], 0::u8, 1::u32, 0::u32, 0::u32, 0::u32, 0::u32

reg $r3::u8, 0::u8, fp1.5::u64
vfma %u16[ $r1::u4 | $r2::u4 | $r3::u4 | $r3::u4 ], 0::u8, 1::u32, 0::u32, 0::u32, 0::u32, 0::u32

; Decrement loop counter in r8
reg $r7::u8, 0::u8, 1::u64
vsub %u32[ $u64::u4 | $r8::u4 | $r7::u4 | $r8::u4 | 0::u16 ], 1::u32, 0::u32, 0::u32, 0::u32
jif %u8[ $OP_JNZ::u1 | $w64::u2 | 0::u1 | $r8::u4 ], 0::u32, 3::u64
