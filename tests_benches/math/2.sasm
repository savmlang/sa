#import *
; -------------------------------------------------------------
; Benchmark 2: RK4 Lorenz Attractor (10,000 internal loops)
; -------------------------------------------------------------
reg $r8::u8, 0::u8, 10000::u64

mark 2::u64
reg $r1::u8, 0::u8, fp10.0::u64
reg $r2::u8, 0::u8, fp28.0::u64
reg $r3::u8, 0::u8, fp2.6666666666666665::u64
reg $r4::u8, 0::u8, fp0.01::u64

reg $r5::u8, 0::u8, fp1.0::u64
reg $r6::u8, 0::u8, fp1.0::u64
reg $r7::u8, 0::u8, fp1.0::u64

; k1_x = sigma * (y0 - x0)
vsubf %u16[ 0::u4 | $r6::u4 | $r5::u4 | $r4::u4 ], 1::u32, 0::u32, 0::u32, 0::u32
vmulf %u16[ 0::u4 | $r1::u4 | $r4::u4 | $r4::u4 ], 1::u32, 0::u32, 0::u32, 0::u32

reg $r1::u8, 0::u8, fp1.0003058869894783::u64
reg $r2::u8, 0::u8, fp1.2401614275069273::u64
reg $r3::u8, 0::u8, fp0.9836932468305814::u64
reg $r4::u8, 0::u8, fp0.0::u64
reg $r5::u8, 0::u8, fp26.0::u64
reg $r6::u8, 0::u8, fp-1.6666666666666665::u64
reg $r7::u8, 0::u8, fp0.0016666666666666668::u64

; Decrement loop counter in r8
reg $r7::u8, 0::u8, 1::u64
vsub %u32[ $u64::u4 | $r8::u4 | $r7::u4 | $r8::u4 | 0::u16 ], 1::u32, 0::u32, 0::u32, 0::u32
jif %u8[ $OP_JNZ::u1 | $w64::u2 | 0::u1 | $r8::u4 ], 0::u32, 2::u64
