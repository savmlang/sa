#import *
; -------------------------------------------------------------
; Benchmark 4: Mandelbrot Map Dynamics (10,000 internal loops)
; -------------------------------------------------------------
reg $r8::u8, 0::u8, 10000::u64

mark 4::u64
reg $r1::u8, 0::u8, fp-0.75::u64
reg $r2::u8, 0::u8, fp0.1::u64
reg $r3::u8, 0::u8, fp-0.71349375::u64
reg $r4::u8, 0::u8, fp0.11975::u64
reg $r5::u8, 0::u8, fp2.0::u64

vmulf %u16[ 0::u4 | $r3::u4 | $r3::u4 | $r6::u4 ], 1::u32, 0::u32, 0::u32, 0::u32
vmulf %u16[ 0::u4 | $r4::u4 | $r4::u4 | $r7::u4 ], 1::u32, 0::u32, 0::u32, 0::u32

vsubf %u16[ 0::u4 | $r6::u4 | $r7::u4 | $r2::u4 ], 1::u32, 0::u32, 0::u32, 0::u32
vaddf %u16[ 0::u4 | $r2::u4 | $r1::u4 | $r6::u4 ], 1::u32, 0::u32, 0::u32, 0::u32

vmulf %u16[ 0::u4 | $r5::u4 | $r3::u4 | $r2::u4 ], 1::u32, 0::u32, 0::u32, 0::u32
reg $r1::u8, 0::u8, fp0.1::u64
vfma %u16[ $r1::u4 | $r4::u4 | $r2::u4 | $r7::u4 ], 0::u8, 1::u32, 0::u32, 0::u32, 0::u32, 0::u32

vmulf %u16[ 0::u4 | $r6::u4 | $r6::u4 | $r2::u4 ], 1::u32, 0::u32, 0::u32, 0::u32
vfma %u16[ $r1::u4 | $r7::u4 | $r2::u4 | $r2::u4 ], 0::u8, 1::u32, 0::u32, 0::u32, 0::u32, 0::u32

; Decrement loop counter in r8
reg $r7::u8, 0::u8, 1::u64
vsub %u32[ $u64::u4 | $r8::u4 | $r7::u4 | $r8::u4 | 0::u16 ], 1::u32, 0::u32, 0::u32, 0::u32
jif %u8[ $OP_JNZ::u1 | $w64::u2 | 0::u1 | $r8::u4 ], 0::u32, 4::u64
