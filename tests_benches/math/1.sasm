#import *
; -------------------------------------------------------------
; Benchmark 1: Cooley-Tukey FFT Butterfly (10,000 internal loops)
; -------------------------------------------------------------
reg $r8::u8, 0::u8, 10000::u64

mark 1::u64
reg $r1::u8, 0::u8, fp2.5::u64
reg $r2::u8, 0::u8, fp1.5::u64
reg $r3::u8, 0::u8, fp4.0::u64
reg $r4::u8, 0::u8, fp-2.0::u64
reg $r5::u8, 0::u8, fp0.7071067811865476::u64
reg $r6::u8, 0::u8, fp-0.7071067811865476::u64

; T_r = x1_r * W_r - x1_i * W_i
vmulf %u16[ 0::u4 | $r3::u4 | $r5::u4 | $r7::u4 ], 1::u32, 0::u32, 0::u32, 0::u32
vmulf %u16[ 0::u4 | $r4::u4 | $r6::u4 | $r2::u4 ], 1::u32, 0::u32, 0::u32, 0::u32
vsubf %u16[ 0::u4 | $r7::u4 | $r2::u4 | $r7::u4 ], 1::u32, 0::u32, 0::u32, 0::u32

; T_i = x1_r * W_i + x1_i * W_r
vmulf %u16[ 0::u4 | $r3::u4 | $r6::u4 | $r2::u4 ], 1::u32, 0::u32, 0::u32, 0::u32
vmulf %u16[ 0::u4 | $r4::u4 | $r5::u4 | $r1::u4 ], 1::u32, 0::u32, 0::u32, 0::u32
vaddf %u16[ 0::u4 | $r2::u4 | $r1::u4 | $r2::u4 ], 1::u32, 0::u32, 0::u32, 0::u32

; Y0 = x0 + T, Y1 = x0 - T
reg $r1::u8, 0::u8, fp2.5::u64
vaddf %u16[ 0::u4 | $r1::u4 | $r7::u4 | $r3::u4 ], 1::u32, 0::u32, 0::u32, 0::u32
reg $r4::u8, 0::u8, fp1.5::u64
vaddf %u16[ 0::u4 | $r4::u4 | $r2::u4 | $r4::u4 ], 1::u32, 0::u32, 0::u32, 0::u32
vsubf %u16[ 0::u4 | $r1::u4 | $r7::u4 | $r5::u4 ], 1::u32, 0::u32, 0::u32, 0::u32
reg $r6::u8, 0::u8, fp1.5::u64
vsubf %u16[ 0::u4 | $r6::u4 | $r2::u4 | $r6::u4 ], 1::u32, 0::u32, 0::u32, 0::u32

; Energy Norm |Y0|^2 + |Y1|^2
vmulf %u16[ 0::u4 | $r3::u4 | $r3::u4 | $r7::u4 ], 1::u32, 0::u32, 0::u32, 0::u32
vmulf %u16[ 0::u4 | $r4::u4 | $r4::u4 | $r1::u4 ], 1::u32, 0::u32, 0::u32, 0::u32
vaddf %u16[ 0::u4 | $r7::u4 | $r1::u4 | $r7::u4 ], 1::u32, 0::u32, 0::u32, 0::u32

vmulf %u16[ 0::u4 | $r5::u4 | $r5::u4 | $r2::u4 ], 1::u32, 0::u32, 0::u32, 0::u32
vmulf %u16[ 0::u4 | $r6::u4 | $r6::u4 | $r1::u4 ], 1::u32, 0::u32, 0::u32, 0::u32
vaddf %u16[ 0::u4 | $r2::u4 | $r1::u4 | $r2::u4 ], 1::u32, 0::u32, 0::u32, 0::u32

vaddf %u16[ 0::u4 | $r7::u4 | $r2::u4 | $r1::u4 ], 1::u32, 0::u32, 0::u32, 0::u32
vfop %u16[ 0::u4 | $r1::u4 | $r2::u4 | $FOP_f64::u1 | $VFOP_SQRT::u3 ], 1::u32, 0::u32, 0::u32

; Decrement loop counter in r8
reg $r7::u8, 0::u8, 1::u64
vsub %u32[ $u64::u4 | $r8::u4 | $r7::u4 | $r8::u4 | 0::u16 ], 1::u32, 0::u32, 0::u32, 0::u32
jif %u8[ $OP_JNZ::u1 | $w64::u2 | 0::u1 | $r8::u4 ], 0::u32, 1::u64
