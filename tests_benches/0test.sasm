; Benchmark 1: The Collatz Convergence Loop (Branching & Integer ALU)
; Footprint: 8 bytes (r1 as n, r2 as step counter, r3 as temp)
; What it stresses:
;   - Tight conditional loops (jif)
;   - Bitwise checks (vbit for parity n & 1)
;   - Integer multiplication (vmul)
;   - Division/shift (vsh)
;   - JIT branch prediction
; Algorithm:
;   n <- n / 2     if n is even
;   n <- 3n + 1    if n is odd
; Run from an input like n = 27 (which takes 111 steps) in an outer loop.

#import *

#define MARK_OUTER_LOOP 1::u64
#define MARK_INNER_LOOP 2::u64
#define MARK_EVEN 3::u64
#define MARK_STEP_DONE 4::u64

; r1: n (current value in Collatz sequence, starts at 27)
; r2: step counter (accumulated total steps across all iterations)
; r3: temp register (parity check / comparison)
; r4: outer loop counter (1000 iterations)
; r5: constant 1
; r6: constant 3
; r7: initial n value = 27

reg $r2::u8, 0::u8, 0::u64
reg $r4::u8, 0::u8, 1000::u64
reg $r5::u8, 0::u8, 1::u64
reg $r6::u8, 0::u8, 3::u64
reg $r7::u8, 0::u8, 27::u64

mark $MARK_OUTER_LOOP::u64
  ; Reset n = 27 (r1 = r7)
  mov %u8[ $r7::u4 | $r1::u4 ]

mark $MARK_INNER_LOOP::u64
  ; Parity check: r3 = r1 & 1 (r5 = 1)
  vbit %u16[ 0::u2 | 0::u2 | $r1::u4 | $r5::u4 | $r3::u4 ], %u8[ $VBIT_AND::u4 | 0::u4 ], 1::u32, 0::u32, 0::u32, 0::u32

  ; If r3 == 0 (even), jump to MARK_EVEN
  jif %u8[ $OP_JZ::u1 | $w64::u2 | 0::u1 | $r3::u4 ], 0::u32, $MARK_EVEN::u64

  ; Odd branch: n = 3 * n + 1
  vmul %u32[ $u64::u4 | $r1::u4 | $r6::u4 | $r1::u4 | 0::u16 ], 1::u32, 0::u32, 0::u32, 0::u32
  vadd %u32[ $u64::u4 | $r1::u4 | $r5::u4 | $r1::u4 | 0::u16 ], 1::u32, 0::u32, 0::u32, 0::u32
  jmp $MARK_STEP_DONE::u64

mark $MARK_EVEN::u64
  ; Even branch: n = n >> 1 (shift right by 1 bit using r5=1)
  vsh %u16[ 0::u3 | $SH_OP_SHR::u1 | $r1::u4 | $r5::u4 | $r1::u4 ], 1::u32, 0::u8, 0::u8, 0::u8

mark $MARK_STEP_DONE::u64
  ; Increment total step counter: r2 = r2 + 1
  vadd %u32[ $u64::u4 | $r2::u4 | $r5::u4 | $r2::u4 | 0::u16 ], 1::u32, 0::u32, 0::u32, 0::u32

  ; Check if n == 1 (r1 == r5)
  vcmp %u8[ $w64::u3 | $IOP_EQ::u5 ], %u16[ $r1::u4 | $r5::u4 | $r3::u4 | 0::u4 ], 1::u32, 0::u32, 0::u32, 0::u32
  ; If r3 == 0 (not 1 yet), continue inner loop
  jif %u8[ $OP_JZ::u1 | $w64::u2 | 0::u1 | $r3::u4 ], 0::u32, $MARK_INNER_LOOP::u64

  ; Decrement outer loop counter: r4 = r4 - 1
  vsub %u32[ $u64::u4 | $r4::u4 | $r5::u4 | $r4::u4 | 0::u16 ], 1::u32, 0::u32, 0::u32, 0::u32
  ; If r4 != 0, continue outer loop
  jif %u8[ $OP_JNZ::u1 | $w64::u2 | 0::u1 | $r4::u4 ], 0::u32, $MARK_OUTER_LOOP::u64
