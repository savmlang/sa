{
  "rust-analyzer.linkedProjects": ["./Cargo.toml"],
  "rust-analyzer.cargo.features": [
    "savm/dev",
    "savmrunshared/pro_standard",
    "satest/pro_standard"
  ],
  "rust-analyzer.cargo.extraEnv": {
    "LLVM_SYS_221_PREFIX": "${workspaceFolder}/llvm/install"
  },
  "rust-analyzer.procMacro.enable": true,
  "rust-analyzer.cargo.sysroot": "discover",
  "terminal.integrated.profiles.windows": {
    "SaVM Development": {
      "path": [
        "pwsh",
        "pwsh.exe",
        "powershell.exe",
        "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe"
      ],
      "color": "terminal.ansiGreen",
      "icon": "vm-running",
      "args": ["-NoExit", "-File", "${workspaceFolder}/devenv.ps1"]
    }
  },
  "terminal.integrated.defaultProfile.windows": "SaVM Development",
  "terminal.integrated.profiles.linux": {
    "SaVM Development": {
      "path": ["dash", "ksh", "bash", "/bin/sh"],
      "color": "terminal.ansiGreen",
      "icon": "vm-running",
      "env": {
        "ENV": "${workspaceFolder}/devenv"
      },
      "args": ["-i"]
    }
  },
  "terminal.integrated.defaultProfile.linux": "SaVM Development",
  "terminal.integrated.profiles.osx": {
    "SaVM Development": {
      "path": "zsh",
      "color": "terminal.ansiGreen",
      "args": ["--rcs", "${workspaceFolder}/devenv"]
    }
  },
  "terminal.integrated.defaultProfile.osx": "SaVM Development",
  "C_Cpp.default.intelliSenseMode": "windows-clang-x64",
  "yaml.disableSchemaDetection": [
    "**/.github/workflows/*.yml",
    "**/.github/workflows/*.yaml",
    "**/.gitea/workflows/*.yml",
    "**/.gitea/workflows/*.yaml",
    "**/.forgejo/workflows/*.yml",
    "**/.forgejo/workflows/*.yaml",
    "file:///e%3A/GitHub/ahqrt-asm-sa/.github/actions/build-savm/action.yml"
  ],
  "C_Cpp.default.compilerPath": "clang",
  "C_Cpp.default.cStandard": "c23",
  "C_Cpp.default.cppStandard": "c++23"
}
